---
import Layout from '../layouts/Layout.astro';
import { getEntry, render } from 'astro:content';
const page = await getEntry('pages', 'sobre-nexox');
if (!page) throw new Error('No se ha encontrado el contenido de Sobre NexoX.');
const { Content } = await render(page);
---
<Layout title="Sobre NexoX" description="NexoX es un espacio dedicado a los videojuegos: un lugar para descubrir nuevas propuestas, conocer qué las hace interesantes y encontrar tu próxima aventura.">
  <article class="article about-page">
    <div class="prose"><Content /></div>
  </article>
</Layout>
