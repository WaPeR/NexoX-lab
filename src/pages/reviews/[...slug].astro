---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ArticleShare from '../../components/ArticleShare.astro';
import { withBase } from '../../lib/paths';
import { getYouTubeId } from '../../lib/youtube';
export async function getStaticPaths() {
  const entries = await getCollection('reviews', ({ data }) => !data.draft);
  return entries.map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}
function selectRelatedReviews(entries, current, limit = 3) {
  const normalize = value => String(value ?? '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim().toLowerCase();
  const genres = value => new Set(String(value ?? '').split(/[,;/|]+/).map(normalize).filter(Boolean));
  const currentGenres = genres(current.data.genre);
  const currentPlatforms = new Set(current.data.platforms.map(normalize).filter(Boolean));
  return entries
    .filter(candidate => candidate.id !== current.id && !candidate.data.draft)
    .map(candidate => ({
      entry: candidate,
      genres: [...genres(candidate.data.genre)].filter(value => currentGenres.has(value)).length,
      platforms: [...new Set(candidate.data.platforms.map(normalize).filter(Boolean))].filter(value => currentPlatforms.has(value)).length
    }))
    .filter(candidate => candidate.genres > 0 || candidate.platforms > 0)
    .sort((a, b) => b.genres - a.genres || b.platforms - a.platforms || b.entry.data.date.valueOf() - a.entry.data.date.valueOf() || a.entry.id.localeCompare(b.entry.id))
    .slice(0, limit)
    .map(candidate => candidate.entry);
}
function toPurchaseUrl(value) {
  if (typeof value !== 'string') return undefined;
  const input = value.trim();
  if (!/^https?:\/\//i.test(input)) return undefined;
  try {
    const url = new URL(input);
    if (!['http:', 'https:'].includes(url.protocol) || !url.hostname || url.username || url.password) return undefined;
    return url.href;
  } catch {
    return undefined;
  }
}
function getPurchaseLinks(data) {
  return [
    { label: 'PC', href: toPurchaseUrl(data.purchasePc) },
    { label: 'Xbox', href: toPurchaseUrl(data.purchaseXbox) },
    { label: 'PlayStation', href: toPurchaseUrl(data.purchasePlaystation) },
    { label: 'Nintendo Switch', href: toPurchaseUrl(data.purchaseSwitch) }
  ].filter(link => Boolean(link.href));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;
const youtubeId = getYouTubeId(data.youtube);
const relatedReviews = selectRelatedReviews(await getCollection('reviews', ({ data }) => !data.draft), entry);
const purchaseLinks = getPurchaseLinks(data);
const shareUrl = new URL(Astro.url.pathname, Astro.site).href;
---
<Layout title={data.title} description={data.description} image={data.image} imageAlt={data.imageAlt} type="article">
  <article class="article">
    <nav class="breadcrumbs" aria-label="Ruta de navegación">
      <ol>
        <li><a href={withBase('/')}>Inicio</a></li>
        <li><a href={withBase('/#latest')}>Reviews</a></li>
        <li><span aria-current="page">{data.title}</span></li>
      </ol>
    </nav>
    <p class="eyebrow">{data.genre || 'NexoX'}</p><h1>{data.title}</h1><p class="lead">{data.description}</p>
    <p class="meta"><span>Por José Ángel &quot;WaPeR&quot;</span> <span aria-hidden="true">·</span> <time datetime={data.date.toISOString()}>{data.date.toLocaleDateString('es-ES',{day:'numeric',month:'long',year:'numeric',timeZone:'UTC'})}</time></p>
    {data.platforms.length > 0 && <div class="tags">{data.platforms.map(platform => <a class="tag platform-link" href={`${withBase('/')}?${new URLSearchParams({ plataforma: platform }).toString()}#latest`} aria-label={`Ver artículos de ${platform}`}>{platform}</a>)}</div>}
    {data.image && <img class="cover" src={withBase(data.image)} alt={data.imageAlt?.trim() || `Portada de ${data.title}`} />}
    <div class="prose"><Content /></div>
    {youtubeId && (
      <section class="review-video" aria-labelledby="review-video-title">
        <h2 id="review-video-title">Vídeo</h2>
        <div class="video-frame">
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${youtubeId}`}
            title={`Vídeo de YouTube: ${data.title}`}
            width="560"
            height="315"
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            allowfullscreen
          ></iframe>
        </div>
        <p class="video-link"><a href={`https://www.youtube.com/watch?v=${youtubeId}`} target="_blank" rel="noopener noreferrer">Ver en YouTube ↗</a></p>
      </section>
    )}
    {purchaseLinks.length > 0 && (
      <section class="purchase-section" aria-labelledby="purchase-title">
        <h2 id="purchase-title">Enlaces de compra</h2>
        <ul class="purchase-links">
          {purchaseLinks.map(link => (
            <li><a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={`Ver enlace de compra para ${link.label} (se abre en otra pestaña)`}>{link.label} ↗</a></li>
          ))}
        </ul>
      </section>
    )}
    <ArticleShare title={data.title} url={shareUrl} />
  </article>
  {relatedReviews.length > 0 && (
    <section class="related-reviews" aria-labelledby="related-title">
      <h2 id="related-title">También puedes leer</h2>
      <p class="meta">Más reviews por género o plataforma.</p>
      <div class="grid">
        {relatedReviews.map(({ id, data: related }) => (
          <a class="card" href={withBase(`/reviews/${id}/`)}>
            {related.image && <img src={withBase(related.image)} alt={related.imageAlt?.trim() || ''} loading="lazy" />}
            <div class="card-content">
              {related.genre && <span class="eyebrow">{related.genre}</span>}
              <h3>{related.title}</h3>
              <p>{related.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}
</Layout>
<style>
  .platform-link:hover { background: #302744; color: #fff; text-decoration: underline; }
  .platform-link:focus-visible { outline: 3px solid #b5a1ff; outline-offset: 3px; }
  .breadcrumbs { margin-bottom: 25px; font-size: 14px; overflow-wrap: anywhere; }
  .breadcrumbs ol { display: flex; flex-wrap: wrap; gap: 6px 10px; padding: 0; margin: 0; list-style: none; }
  .breadcrumbs li + li::before { content: '›'; margin-right: 10px; color: #a5abc1; }
  .breadcrumbs a { color: #b5a1ff; }
  .breadcrumbs [aria-current] { color: #a5abc1; }
  .related-reviews { margin-top: 48px; padding-top: 24px; border-top: 1px solid #262a3b; }
  .review-video { margin-top: 40px; padding-top: 12px; border-top: 1px solid #262a3b; }
  .video-frame { width: 100%; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 16px; background: #000; }
  .video-frame iframe { display: block; width: 100%; height: 100%; border: 0; }
  .video-link { margin-top: 12px; font-size: 14px; }
  .video-link a { color: #b5a1ff; text-decoration: underline; }
  .purchase-section { margin-top: 40px; padding-top: 12px; border-top: 1px solid #262a3b; }
  .purchase-links { display: flex; flex-wrap: wrap; gap: 12px; list-style: none; padding: 0; margin: 20px 0 0; }
  .purchase-links a { display: inline-block; padding: 10px 18px; border: 1px solid #64518e; border-radius: 12px; background: #232338; color: #d4c8ff; font-weight: 650; }
  .purchase-links a:hover { border-color: #b5a1ff; background: #302744; color: #fff; }
</style>
