---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../lib/paths';
import { getCollection } from 'astro:content';
const reviews = (await getCollection('reviews', ({ data }) => !data.draft)).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
const formatDate = (date) => date.toLocaleDateString('es-ES', { day:'numeric', month:'long', year:'numeric', timeZone:'UTC' });
const platforms = ['PC', 'PlayStation 5', 'PlayStation 4', 'Xbox Series X|S', 'Xbox One', 'Nintendo Switch', 'Nintendo Switch 2', 'Android', 'iOS'];
---
<Layout description="Descubre reviews y análisis de videojuegos en NexoX. Explora juegos de acción, aventuras, terror e indies, con información sobre plataformas y géneros.">
  <section class="hero"><span class="eyebrow">Tu próximo mundo empieza aquí</span><h1>Conecta con tu<br />próximo juego.</h1><p class="lead">Reviews y análisis para descubrir videojuegos, conocer sus propuestas y encontrar tu próxima aventura.</p></section>
  <section aria-labelledby="latest">
    <h2 id="latest">Últimos artículos</h2>
    {reviews.length > 0 && (
      <form id="review-filters" class="review-filters" role="search" aria-label="Buscar artículos" hidden>
        <div class="filter-field">
          <label for="review-search">Buscar un juego</label>
          <input id="review-search" type="search" placeholder="Buscar por título o resumen…" autocomplete="off" aria-controls="article-list" />
        </div>
        <div class="filter-field">
          <label for="review-platform">Plataforma</label>
          <select id="review-platform" aria-controls="article-list">
            <option value="">Todas las plataformas</option>
            {platforms.map(platform => <option value={platform}>{platform}</option>)}
          </select>
        </div>
        <button id="clear-review-filters" type="button">Limpiar filtros</button>
      </form>
    )}
    <p id="search-count" class="meta" role="status" aria-live="polite" hidden></p>
    <div id="article-list" class="grid">
      {reviews.map(({id,data}) => <a class="card" href={withBase(`/reviews/${id}/`)} data-review-card data-search={`${data.title} ${data.description}`} data-platforms={JSON.stringify(data.platforms)}>
        {data.image ? <img src={withBase(data.image)} alt={data.imageAlt?.trim() || ''} loading="lazy" /> : <div class="placeholder" aria-hidden="true">NX</div>}
        <div class="card-content"><time class="meta" datetime={data.date.toISOString()}>{formatDate(data.date)}</time><h3>{data.title}</h3><p>{data.description}</p><span class="eyebrow">Leer artículo →</span></div>
      </a>)}
    </div>
    <p id="search-empty" class="empty-results" hidden>No hay artículos que coincidan. Prueba otra búsqueda o limpia los filtros.</p>
    {reviews.length === 0 && <p>Estamos preparando los primeros artículos. Vuelve pronto.</p>}
  </section>
</Layout>
<script>
  const normalizeText = value => value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/\s+/g, ' ').trim();
  const matchesReview = (text, platforms, query, platform) => normalizeText(query).split(' ').filter(Boolean).every(term => normalizeText(text).includes(term)) && (!platform || platforms.includes(platform));
  const filters = document.querySelector('#review-filters');
  const search = document.querySelector('#review-search');
  const platform = document.querySelector('#review-platform');
  const clear = document.querySelector('#clear-review-filters');
  const count = document.querySelector('#search-count');
  const empty = document.querySelector('#search-empty');
  const cards = Array.from(document.querySelectorAll('[data-review-card]'));
  if (filters instanceof HTMLFormElement && search instanceof HTMLInputElement && platform instanceof HTMLSelectElement && clear instanceof HTMLButtonElement && count instanceof HTMLElement && empty instanceof HTMLElement) {
    const update = () => {
      let visible = 0;
      for (const card of cards) {
        if (!(card instanceof HTMLElement)) continue;
        const matches = matchesReview(card.dataset.search || '', JSON.parse(card.dataset.platforms || '[]'), search.value, platform.value);
        card.hidden = !matches;
        if (matches) visible++;
      }
      count.textContent = `${visible} ${visible === 1 ? 'artículo' : 'artículos'}`;
      empty.hidden = visible !== 0;
    };
    filters.addEventListener('submit', event => event.preventDefault());
    search.addEventListener('input', update);
    platform.addEventListener('change', update);
    clear.addEventListener('click', () => { search.value = ''; platform.value = ''; update(); });
    filters.hidden = false;
    count.hidden = false;
    update();
  }
</script>
<style>
  .review-filters { display: flex; flex-wrap: wrap; align-items: end; gap: 16px; margin: 24px 0 16px; }
  .filter-field { flex: 1 1 220px; min-width: 0; }
  label { display: block; margin-bottom: 6px; color: #bcc1d4; font-size: 14px; }
  input, select, button { font: inherit; color: #edf0fa; background: #131722; border: 1px solid #64518e; border-radius: 10px; padding: 12px; }
  input, select { width: 100%; min-width: 0; }
  button { cursor: pointer; }
  button:hover { border-color: #b5a1ff; }
  input:focus-visible, select:focus-visible, button:focus-visible { outline: 3px solid #b5a1ff; outline-offset: 3px; }
  .empty-results { margin-top: 24px; color: #b8bed1; }
  [hidden] { display: none !important; }
</style>
