---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ArticleShare from '../../components/ArticleShare.astro';
import GameFacts from '../../components/GameFacts.astro';
import { withBase } from '../../lib/paths';
import { getYouTubeId } from '../../lib/youtube';
import { contentPath, getContentType } from '../../lib/content-types.js';
export async function getStaticPaths() {
  const entries = await getCollection('previews', ({ data }) => !data.draft);
  return entries.map(entry => ({ params: { slug: entry.id }, props: { entry } }));
}
function purchaseUrl(value: unknown) {
  if (typeof value !== 'string' || !/^https?:\/\//i.test(value.trim())) return undefined;
  try {
    const url = new URL(value.trim());
    return ['http:', 'https:'].includes(url.protocol) && url.hostname && !url.username && !url.password ? url.href : undefined;
  } catch { return undefined; }
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;
const section = getContentType('previews');
const context = data.testContext?.trim();
const youtubeId = getYouTubeId(data.youtube);
const purchaseLinks = [
  { label: 'PC', href: purchaseUrl(data.purchasePc) },
  { label: 'Xbox', href: purchaseUrl(data.purchaseXbox) },
  { label: 'PlayStation', href: purchaseUrl(data.purchasePlaystation) },
  { label: 'Nintendo Switch', href: purchaseUrl(data.purchaseSwitch) }
].filter(link => Boolean(link.href));
const shareUrl = new URL(withBase(contentPath('previews', entry.id)), Astro.site).href;
---
<Layout title={data.title} description={data.description} image={data.image} imageAlt={data.imageAlt} type="article">
  <article class="article">
    <nav class="breadcrumbs" aria-label="Ruta de navegación">
      <ol>
        <li><a href={withBase('/')}>Inicio</a></li>
        <li><a href={withBase(section.path)}>{section.label}</a></li>
        <li><span aria-current="page">{data.title}</span></li>
      </ol>
    </nav>
    <p class="eyebrow">{section.singular}{data.genre ? ` · ${data.genre}` : ''}</p>
    <h1>{data.title}</h1><p class="lead">{data.description}</p>
    <p class="meta"><span>Por José Ángel &quot;WaPeR&quot;</span> <span aria-hidden="true">·</span> <time datetime={data.date.toISOString()}>{data.date.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}</time></p>
    {data.platforms.length > 0 && <div class="tags">{data.platforms.map(platform => <a class="tag platform-link" href={`${withBase('/buscar/')}?${new URLSearchParams({ plataforma: platform }).toString()}#search-results`} aria-label={`Ver artículos de ${platform}`}>{platform}</a>)}</div>}
    {data.image && <img class="cover" src={withBase(data.image)} alt={data.imageAlt?.trim() || `Portada de ${data.title}`} />}
    <GameFacts data={data} />
    {context && <section class="test-context" aria-labelledby="test-context-title">
      <h2 id="test-context-title">Contexto de la prueba</h2><p>{context}</p>
    </section>}
    <div class="prose"><Content /></div>
    {youtubeId && <section class="preview-video" aria-labelledby="preview-video-title">
      <h2 id="preview-video-title">Vídeo</h2>
      <div class="video-frame"><iframe src={`https://www.youtube-nocookie.com/embed/${youtubeId}`} title={`Vídeo de YouTube: ${data.title}`} width="560" height="315" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe></div>
      <p class="video-link"><a href={`https://www.youtube.com/watch?v=${youtubeId}`} target="_blank" rel="noopener noreferrer">Ver en YouTube ↗</a></p>
    </section>}
    {purchaseLinks.length > 0 && <section class="purchase-section" aria-labelledby="purchase-title">
      <h2 id="purchase-title">Enlaces de compra</h2>
      <ul class="purchase-links">{purchaseLinks.map(link => <li><a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={`Ver enlace de compra para ${link.label} (se abre en otra pestaña)`}>{link.label} ↗</a></li>)}</ul>
    </section>}
    <ArticleShare title={data.title} url={shareUrl} />
  </article>
</Layout>
<style>
  .platform-link:hover { background: #302744; color: #fff; text-decoration: underline; }
  .platform-link:focus-visible { outline: 3px solid #b5a1ff; outline-offset: 3px; }
  .breadcrumbs { margin-bottom: 25px; font-size: 14px; overflow-wrap: anywhere; }
  .breadcrumbs ol { display: flex; flex-wrap: wrap; gap: 6px 10px; padding: 0; margin: 0; list-style: none; }
  .breadcrumbs li + li::before { content: '›'; margin-right: 10px; color: #a5abc1; }
  .breadcrumbs a { color: #b5a1ff; }
  .breadcrumbs [aria-current] { color: #a5abc1; }
  .test-context { margin: 28px 0; padding: 24px; border: 1px solid #64518e; border-radius: 16px; background: #131722; }
  .test-context h2 { margin: 0 0 12px; font-size: 24px; }
  .test-context p { margin: 0; white-space: pre-line; overflow-wrap: anywhere; color: #b8bed1; }
  .preview-video, .purchase-section { margin-top: 40px; padding-top: 12px; border-top: 1px solid #262a3b; }
  .video-frame { width: 100%; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 16px; background: #000; }
  .video-frame iframe { display: block; width: 100%; height: 100%; border: 0; }
  .video-link { margin-top: 12px; font-size: 14px; }
  .video-link a { color: #b5a1ff; text-decoration: underline; }
  .purchase-links { display: flex; flex-wrap: wrap; gap: 12px; list-style: none; padding: 0; margin: 20px 0 0; }
  .purchase-links a { display: inline-block; padding: 10px 18px; border: 1px solid #64518e; border-radius: 12px; background: #232338; color: #d4c8ff; font-weight: 650; }
  .purchase-links a:hover { border-color: #b5a1ff; background: #302744; color: #fff; }
</style>
