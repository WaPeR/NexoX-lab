---
import { withBase } from '../lib/paths';
const { title = 'NexoX', description = 'Videojuegos, historias y mundos por descubrir.', image, imageAlt, type = 'website' } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = image ? new URL(withBase(image), Astro.site) : undefined;
const imageDescription = imageAlt?.trim() || `Portada de ${title}`;
const pageTitle = title === 'NexoX' ? 'NexoX — Reviews y análisis de videojuegos' : `${title} | NexoX`;
const socialTitle = title === 'NexoX' ? pageTitle : title;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:site_name" content="NexoX" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    {imageURL && <>
      <meta property="og:image" content={imageURL.href} />
      <meta property="og:image:alt" content={imageDescription} />
    </>}
    <meta name="twitter:card" content={imageURL ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={description} />
    {imageURL && <>
      <meta name="twitter:image" content={imageURL.href} />
      <meta name="twitter:image:alt" content={imageDescription} />
    </>}
    <link rel="icon" type="image/png" sizes="64x64" href={withBase('/favicon.png')} />
    <link rel="alternate" type="application/rss+xml" title="NexoX — RSS" href={new URL(withBase('/rss.xml'), Astro.site)} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header"><a class="logo" href={withBase('/')} aria-label="NexoX, inicio">Nexo<span>X</span></a><nav aria-label="Principal"><a href={withBase('/')}>Inicio y artículos</a></nav></header>
    <main><slot /></main>
    <footer>NexoX · Videojuegos, historias y mundos por descubrir. · <a href={withBase('/rss.xml')}>RSS</a></footer>
  </body>
</html>
<style is:global>
  :root{font-family:system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;color:#edf0fa;background:#0b0d14;line-height:1.7;color-scheme:dark}
  *{box-sizing:border-box}body{margin:0}a{color:inherit;text-decoration:none}a:hover{color:#b5a1ff}a:focus-visible{outline:3px solid #b5a1ff;outline-offset:5px}
  .site-header,main,footer{width:min(1100px,calc(100% - 40px));margin:auto}.site-header{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:25px 0;border-bottom:1px solid #262a3b}.logo{font-size:30px;font-weight:850;letter-spacing:-1.5px}.logo span{color:#a68aff}nav{font-size:14px;color:#bcc1d4}
  main{min-height:70vh;padding:48px 0 64px}footer{padding:25px 0;border-top:1px solid #262a3b;color:#a5abc1;font-size:14px}h1,h2,h3{line-height:1.15;letter-spacing:-.035em}h1{font-size:clamp(36px,7vw,68px);margin:12px 0 20px}h2{font-size:28px}p{margin:0 0 20px}.eyebrow{color:#b5a1ff;font-size:13px;font-weight:750;letter-spacing:.12em;text-transform:uppercase}.lead{max-width:650px;font-size:19px;color:#b8bed1}.hero{padding:20px 0 45px}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(280px,100%),1fr));gap:24px}.card{border:1px solid #292d40;background:#131722;border-radius:18px;overflow:hidden;transition:border-color .2s}.card:hover{border-color:#a68aff}.card-content{padding:25px}.card h3{font-size:25px;margin:12px 0}.card p{color:#b8bed1}.card img,.cover{display:block;width:100%;aspect-ratio:16/9;object-fit:cover}.placeholder{height:150px;background:linear-gradient(135deg,#30234e,#162e43);display:grid;place-items:center;font-size:45px;font-weight:900;letter-spacing:-3px;color:#c7b6ff}.meta{color:#a5abc1;font-size:14px}.article{max-width:780px;margin:auto}.article h1{font-size:clamp(34px,6vw,54px)}.cover{border-radius:16px;margin:25px 0}.prose{font-size:18px;overflow-wrap:anywhere}.prose a{color:#b5a1ff;text-decoration:underline}.prose img{max-width:100%;height:auto;border-radius:12px}.prose h2,.prose h3{margin-top:38px}.prose li{margin-bottom:8px}.back{display:inline-block;margin-bottom:25px;color:#b5a1ff}.tags{display:flex;flex-wrap:wrap;gap:8px;margin:20px 0}.tag{background:#232338;color:#d4c8ff;padding:4px 12px;border-radius:99px;font-size:13px}
</style>
