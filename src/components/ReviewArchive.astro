---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../lib/paths';
import { getCollection } from 'astro:content';
import { getNewsPage } from '../lib/news-pagination.js';
const { pageNumber = 1 } = Astro.props;
const [reviews, news] = await Promise.all([
  getCollection('reviews', ({ data }) => !data.draft),
  getCollection('news', ({ data }) => !data.draft)
]);
const entries = [
  ...reviews.map(entry => ({ entry, type: 'reviews' })),
  ...news.map(entry => ({ entry, type: 'noticias' }))
].sort((a, b) => b.entry.data.date.valueOf() - a.entry.data.date.valueOf() || `${a.type}/${a.entry.id}`.localeCompare(`${b.type}/${b.entry.id}`));
const state = getNewsPage(entries, pageNumber);
const pagePath = (page: number) => page <= 1 ? '/' : `/pagina/${page}/`;
const title = state.page === 1 ? 'NexoX' : `Publicaciones — Página ${state.page}`;
---
<Layout title={title} description="Reviews y noticias de videojuegos en NexoX, ordenadas de la más reciente a la más antigua.">
  <section class="hero"><span class="eyebrow">Tu próximo mundo empieza aquí</span><h1>Conecta con tu<br />próximo juego.</h1><p class="lead">Reviews y noticias para descubrir videojuegos, conocer sus propuestas y encontrar tu próxima aventura.</p></section>
  <section aria-labelledby="latest">
    <h2 id="latest">{state.page === 1 ? 'Últimas publicaciones' : `Publicaciones — Página ${state.page}`}</h2>
    <p class="meta">{state.total} {state.total === 1 ? 'publicación' : 'publicaciones'}{state.total > 0 ? ` · Página ${state.page} de ${state.totalPages}` : ''}</p>
    <div class="grid">
      {state.items.map(({ entry: { id, data }, type }) => <a class="card" href={withBase(`/${type}/${id}/`)}>
        {data.image ? <img src={withBase(data.image)} alt={data.imageAlt?.trim() || ''} loading="lazy" /> : <div class="placeholder" aria-hidden="true">NX</div>}
        <div class="card-content">
          <span class="eyebrow">{type === 'noticias' ? 'Noticia' : 'Review'}</span>
          <p class="meta"><time datetime={data.date.toISOString()}>{data.date.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}</time></p>
          <h3>{data.title}</h3><p>{data.description}</p>
          <span class="eyebrow">{type === 'noticias' ? 'Leer noticia →' : 'Leer review →'}</span>
        </div>
      </a>)}
    </div>
    {state.total === 0 && <p>Estamos preparando las primeras publicaciones. Vuelve pronto.</p>}
    {state.totalPages > 1 && <nav class="archive-pagination" aria-label="Paginación de publicaciones">
      {state.page > 1 && <a href={`${withBase(pagePath(state.page - 1))}#latest`} rel="prev">← Anterior</a>}
      {Array.from({ length: state.totalPages }, (_, index) => index + 1).map(number => number === state.page ? <span aria-current="page">{number}</span> : <a href={`${withBase(pagePath(number))}#latest`} aria-label={`Ir a la página ${number}`}>{number}</a>)}
      {state.page < state.totalPages && <a href={`${withBase(pagePath(state.page + 1))}#latest`} rel="next">Siguiente →</a>}
    </nav>}
  </section>
</Layout>
<style>
  .archive-pagination { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 10px; margin-top: 32px; }
  .archive-pagination a, .archive-pagination span { display: inline-flex; align-items: center; justify-content: center; min-width: 44px; min-height: 44px; padding: 8px 14px; border: 1px solid #64518e; border-radius: 10px; color: #d4c8ff; background: #131722; }
  .archive-pagination [aria-current] { background: #302744; border-color: #b5a1ff; color: #fff; font-weight: 750; }
  .archive-pagination a:hover { border-color: #b5a1ff; }
</style>
